[ext_resource type="Script" path="res://scripts/data/rule_entry.gd" id="1"]

[resource]
script = ExtResource("1")
piece_id = &"backstep_pawn"
title = "The backstep pawn"
original_rule = "A pawn marches forward and may never retreat."
